  <script is:inline>
    // ═══════════ HERO SLIDESHOW — always cycling, faster on scroll ═══════════
    (function() {
      const imgs = document.querySelectorAll('.hero-slideshow__img');
      if (!imgs.length) return;
      let current = 0;
      let lastScroll = 0;
      let scrollCycleAcc = 0;
      const pixelsPerCycle = 18;

      function next() {
        imgs[current].classList.remove('is-active');
        current = (current + 1) % imgs.length;
        imgs[current].classList.add('is-active');
      }

      // Baseline auto-cycle
      setInterval(next, 500);

      // Also cycle rapidly on scroll
      window.addEventListener('scroll', () => {
        const delta = Math.abs(window.scrollY - lastScroll);
        lastScroll = window.scrollY;
        scrollCycleAcc += delta;
        while (scrollCycleAcc >= pixelsPerCycle) {
          scrollCycleAcc -= pixelsPerCycle;
          next();
        }
      });
    })();

    // ═══════════ COPY EMAIL ═══════════
    window.copyEmail = function() {
      navigator.clipboard.writeText('jake@bryt.works');
      const msg = document.getElementById('email-msg');
      msg.classList.add('show');
      setTimeout(() => msg.classList.remove('show'), 1500);
    };

    // ═══════════ GALLERY DRAG-TO-SCROLL ═══════════
    function initDragScroll(el) {
      if (!el) return;
      let isDown = false, startX, scrollLeft;
      el.addEventListener('mousedown', (e) => {
        isDown = true;
        el.style.cursor = 'grabbing';
        startX = e.pageX - el.offsetLeft;
        scrollLeft = el.scrollLeft;
      });
      el.addEventListener('mouseleave', () => { isDown = false; el.style.cursor = 'grab'; });
      el.addEventListener('mouseup', () => { isDown = false; el.style.cursor = 'grab'; });
      el.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - el.offsetLeft;
        el.scrollLeft = scrollLeft - (x - startX) * 1.5;
      });
    }

    const mainGallery = document.getElementById('gallery-track');
    const footerGallery = document.getElementById('footer-gallery');
    initDragScroll(mainGallery);
    initDragScroll(footerGallery);

    // Gallery counter
    if (mainGallery) {
      mainGallery.addEventListener('scroll', () => {
        const items = mainGallery.querySelectorAll('.gallery-item');
        const scrollPos = mainGallery.scrollLeft + mainGallery.clientWidth / 2;
        let current = 1;
        items.forEach((item, i) => {
          if (item.offsetLeft < scrollPos) current = i + 1;
        });
        const counter = document.getElementById('gallery-current');
        if (counter) counter.textContent = current;
      });
    }

    // ═══════════ AGENT TERMINAL ═══════════
    (function() {
      const body = document.getElementById('agent-terminal-body');
      if (!body) return;

      const bootLines = [
        { text: 'yerb', cls: 'boot-title' },
        { text: 'v3.1 · mac mini m2 · 4 agents', cls: 'boot-sub' },
        { text: '', cls: 'dim' },
        { text: 'scheduler', cls: 'boot-agent', delay: 400 },
        { text: 'market', cls: 'boot-agent', delay: 350 },
        { text: 'scraper', cls: 'boot-agent', delay: 300 },
        { text: 'builder', cls: 'boot-agent', delay: 350 },
        { text: '', cls: 'dim' },
        { text: '', cls: 'boot-bar' },
        { text: '', cls: 'dim' },
        { text: 'all systems online · uptime 847h', cls: 'boot-ready' },
      ];

      const lines = [
        { text: '[scheduler] syncing calendar — 3 events today', cls: 'blue' },
        { text: '[market] scanning polymarket positions', cls: 'dim' },
        { text: '[market] BTC > $94k — holding', cls: 'yellow' },
        { text: '[scraper] 2 new listings found', cls: 'accent' },
        { text: '[builder] running test suite — 47/47 passed', cls: 'green' },
        { text: '> order sushi', cls: 'user' },
        { text: '[scheduler] placing order — spicy tuna, salmon nigiri', cls: 'blue' },
        { text: '[scheduler] order confirmed — eta 35min', cls: 'green' },
        { text: '[market] ETH position +4.2% — no action', cls: 'yellow' },
        { text: '> deploy site', cls: 'user' },
        { text: '[builder] building jakedev.org...', cls: 'dim' },
        { text: '[builder] deploying jakedev.org — done', cls: 'green' },
        { text: '[builder] pushed 3 commits to main', cls: 'blue' },
        { text: '> dinner reservation friday 7pm', cls: 'user' },
        { text: '[scheduler] booking — party of 2, friday 7pm', cls: 'blue' },
        { text: '[scheduler] confirmed — HSK italian', cls: 'green' },
        { text: '[market] polymarket: recalculating edge', cls: 'dim' },
        { text: '> market positions', cls: 'user' },
        { text: '[market] portfolio +2.8% — 3 positions open', cls: 'green' },
        { text: '[market] opened position — 0.12 ETH', cls: 'yellow' },
        { text: '> email client re: timeline', cls: 'user' },
        { text: '[scheduler] drafting email — project timeline update', cls: 'blue' },
        { text: '[scheduler] sent to alex@brytwks.com', cls: 'green' },
        { text: '[scraper] no new matches since 14:30', cls: 'dim' },
        { text: '[builder] lint pass — 0 warnings', cls: 'green' },
        { text: '> queue fuel build', cls: 'user' },
        { text: '[builder] queued overnight build — fuel v2.1', cls: 'blue' },
        { text: '[yerb] all agents nominal', cls: 'accent' },
        { text: '[scheduler] sleep mode in 45m', cls: 'dim' },
      ];

      let i = 0;
      let bootIndex = 0;
      const maxLines = 14;
      let speed = 500;
      let booting = true;

      function renderLine(line) {
        const el = document.createElement('div');
        el.className = 'agent-terminal__line agent-terminal__line--' + line.cls;
        el.textContent = line.text;
        body.appendChild(el);
        if (body.children.length > maxLines) {
          body.removeChild(body.firstChild);
        }
      }

      function bootSequence() {
        if (bootIndex >= bootLines.length) {
          booting = false;
          setTimeout(addLine, 600);
          return;
        }
        const bl = bootLines[bootIndex];
        if (bl.cls === 'boot-bar') {
          const el = document.createElement('div');
          el.className = 'agent-terminal__line agent-terminal__line--boot-bar';
          const barWidth = 20;
          let filled = 0;
          const barSpan = document.createElement('span');
          barSpan.className = 'term-bar';
          barSpan.textContent = '░'.repeat(barWidth);
          el.appendChild(barSpan);
          const pct = document.createElement('span');
          pct.className = 'term-bar-pct';
          pct.textContent = '  0%';
          el.appendChild(pct);
          body.appendChild(el);
          if (body.children.length > maxLines) body.removeChild(body.firstChild);
          const barInt = setInterval(() => {
            filled++;
            barSpan.textContent = '█'.repeat(filled) + '░'.repeat(barWidth - filled);
            pct.textContent = '  ' + Math.round((filled / barWidth) * 100) + '%';
            if (filled >= barWidth) {
              clearInterval(barInt);
              bootIndex++;
              setTimeout(bootSequence, 200);
            }
          }, 40);
          return;
        } else if (bl.cls === 'boot-agent') {
          // Show agent name with spinner, then resolve
          const el = document.createElement('div');
          el.className = 'agent-terminal__line agent-terminal__line--boot-agent';
          const spinChars = ['⠋','⠙','⠹','⠸','⠼','⠴','⠦','⠧','⠇','⠏'];
          let si = 0;
          const sp = document.createElement('span');
          sp.className = 'term-spinner';
          sp.textContent = spinChars[0];
          el.appendChild(sp);
          el.appendChild(document.createTextNode(' ' + bl.text));
          body.appendChild(el);
          if (body.children.length > maxLines) body.removeChild(body.firstChild);
          const spinInt = setInterval(() => { si=(si+1)%spinChars.length; sp.textContent=spinChars[si]; }, 60);
          setTimeout(() => {
            clearInterval(spinInt);
            el.innerHTML = '<span class="term-check">✓</span> ' + bl.text;
            el.classList.add('agent-terminal__line--resolved');
            bootIndex++;
            setTimeout(bootSequence, 150);
          }, bl.delay || 300);
        } else {
          renderLine(bl);
          bootIndex++;
          setTimeout(bootSequence, bl.cls === 'boot-title' ? 200 : 100);
        }
      }

      const tokensEl = document.getElementById('term-tokens');
      const ctxFill = document.getElementById('term-ctx-fill');
      const ctxPct = document.getElementById('term-ctx-pct');
      let tokenCount = 0;
      const maxCtx = 200000;

      function updateStats() {
        const add = Math.floor(800 + Math.random() * 2400);
        tokenCount = Math.min(tokenCount + add, maxCtx);
        const pct = Math.round((tokenCount / maxCtx) * 100);
        if (tokensEl) tokensEl.textContent = tokenCount.toLocaleString() + ' tokens';
        if (ctxFill) ctxFill.style.width = pct + '%';
        if (ctxPct) ctxPct.textContent = pct + '%';
        // Reset at ~85% to simulate new conversation
        if (pct > 85) tokenCount = Math.floor(Math.random() * 8000);
      }

      function addLine() {
        // Remove previous thinking indicator
        const prev = body.querySelector('.term-thinking');
        if (prev) prev.remove();

        renderLine(lines[i % lines.length]);
        i++;
        updateStats();

        // Add thinking indicator
        const thinking = document.createElement('div');
        thinking.className = 'agent-terminal__line term-thinking';
        thinking.innerHTML = '<span class="term-dots"><span>·</span><span>·</span><span>·</span></span>';
        body.appendChild(thinking);
        if (body.children.length > maxLines) body.removeChild(body.firstChild);

        setTimeout(addLine, speed + Math.random() * (speed * 0.6));
      }

      // Start boot when terminal scrolls into view
      const termEl = document.getElementById('agent-terminal');
      const termObs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          termObs.disconnect();
          setTimeout(bootSequence, 400);
        }
      }, { threshold: 0.3 });
      termObs.observe(termEl);

      // Speed up on scroll, ease back gradually
      let scrollTimeout;
      let easeInterval;
      window.addEventListener('scroll', () => {
        speed = 80;
        clearTimeout(scrollTimeout);
        clearInterval(easeInterval);
        scrollTimeout = setTimeout(() => {
          easeInterval = setInterval(() => {
            speed = Math.min(speed + 50, 500);
            if (speed >= 500) clearInterval(easeInterval);
          }, 150);
        }, 300);
      });
    })();

    // ═══════════ WIDGET PREVIEW ANIMATION ═══════════
    (function() {
      const card = document.querySelector('.has-preview');
      if (!card) return;

      const totalEl = document.getElementById('widget-total');
      const todayEl = document.getElementById('widget-today');
      const costEl = document.getElementById('widget-cost');
      const barsEl = document.getElementById('widget-bars');
      const labelEl = document.getElementById('widget-chart-label');

      let total = 14.2, today = 847.3, cost = 142.80;
      let tickInt;

      function fmt(n) { return n >= 1000 ? (n/1000).toFixed(1) + 'M' : n.toFixed(1) + 'K'; }

      const chartViews = [
        {
          label: 'Hourly',
          bars: [
            { h: 20, l: '6a' }, { h: 45, l: '8a' }, { h: 78, l: '10a' },
            { h: 55, l: '12p' }, { h: 30, l: '2p' }, { h: 65, l: '4p' },
            { h: 88, l: '6p' }, { h: 72, l: '8p' }, { h: 40, l: '10p' },
          ],
          peak: 6, today: null,
        },
        {
          label: '7-day',
          bars: [
            { h: 35, l: 'M' }, { h: 62, l: 'T' }, { h: 48, l: 'W' },
            { h: 85, l: 'T' }, { h: 71, l: 'F' }, { h: 40, l: 'S' },
            { h: 55, l: 'S' },
          ],
          peak: 3, today: 6,
        },
        {
          label: 'Monthly',
          bars: [
            { h: 30, l: 'Sep' }, { h: 52, l: 'Oct' }, { h: 68, l: 'Nov' },
            { h: 45, l: 'Dec' }, { h: 74, l: 'Jan' }, { h: 90, l: 'Feb' },
            { h: 58, l: 'Mar' },
          ],
          peak: 5, today: 6,
        },
      ];

      let viewIndex = 0;
      let cycleInt;

      function renderBars(view) {
        // Fade out
        barsEl.style.opacity = '0';
        barsEl.style.transform = 'translateY(4px)';
        labelEl.style.opacity = '0';

        setTimeout(() => {
          labelEl.textContent = view.label + ' usage';
          barsEl.innerHTML = view.bars.map((b, i) => {
            let cls = 'widget-mock__bar';
            if (i === view.peak) cls += ' widget-mock__bar--peak';
            else if (i === view.today) cls += ' widget-mock__bar--today';
            return '<div class="' + cls + '" style="--h: ' + b.h + '%;"><span>' + b.l + '</span></div>';
          }).join('');

          // Fade in
          requestAnimationFrame(() => {
            barsEl.style.opacity = '1';
            barsEl.style.transform = 'translateY(0)';
            labelEl.style.opacity = '1';
          });
        }, 250);
      }

      function cycleChart() {
        viewIndex = (viewIndex + 1) % chartViews.length;
        renderBars(chartViews[viewIndex]);
      }

      // Start cycling when card is visible
      const chartObs = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          cycleInt = setInterval(cycleChart, 3000);
        } else {
          clearInterval(cycleInt);
        }
      }, { threshold: 0.2 });
      chartObs.observe(card);

      card.addEventListener('mouseenter', () => {
        tickInt = setInterval(() => {
          total += 0.8 + Math.random() * 2.4;
          today += 0.3 + Math.random() * 1.2;
          cost += 0.01 + Math.random() * 0.08;
          if (totalEl) totalEl.textContent = total >= 1000 ? (total/1000).toFixed(1) + 'B' : total.toFixed(1) + 'M';
          if (todayEl) todayEl.textContent = fmt(today);
          if (costEl) costEl.textContent = '~$' + cost.toFixed(2);
        }, 800);
      });

      card.addEventListener('mouseleave', () => {
        clearInterval(tickInt);
      });
    })();

  </script>
</BaseLayout>
