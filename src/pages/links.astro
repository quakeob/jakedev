---
const destination = '/about';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://jakedev.org/about" />
    <title>Jake Davis — Creative + Developer</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>This page moved to <a href={destination}>jakedev.org/about</a>.</p>
  </body>
</html>
