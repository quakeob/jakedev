---
import DGLayout from '../../components/dg/DGLayout.astro';
import DGHeader from '../../components/dg/DGHeader.astro';
import DGFooter from '../../components/dg/DGFooter.astro';
import DGProductCard from '../../components/dg/DGProductCard.astro';
import { dgCategories, dgProducts } from '../../data/dg';
---

<DGLayout title="Doug's Shoot'n Sports — Storefront Concept">
  <DGHeader />
  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">Taylorsville, Utah · Family owned since 1973</p>
        <h1>LOCAL EXPERTISE.<br />SERIOUS INVENTORY.</h1>
        <p class="hero-lede">Shop firearms, ammunition, optics and gear online—then pick up with a team that knows the products and the process.</p>
        <div class="button-row">
          <a class="button primary" href="/dg/shop">Shop all inventory</a>
          <a class="button secondary" href="/dg/product">How online pickup works</a>
        </div>
        <div class="hero-proof" aria-label="Store benefits">
          <span><b>50+ years</b> serving Utah</span>
          <span><b>Live inventory</b> updated daily</span>
          <span><b>Local pickup</b> handled in store</span>
        </div>
      </div>
      <div class="feature-product">
        <div class="feature-topline"><span class="pill light">Weekend price</span><span class="muted">Ends Saturday</span></div>
        <div class="feature-visual"><span class="feature-index">01</span><img src="/dg/stevens.png" alt="Stevens 320 Security pump shotgun" /></div>
        <div class="feature-details">
          <div><p class="kicker">Stevens · 12 Gauge</p><h2>320 Security Pump</h2><p class="muted">18.5&quot; barrel · 5 rounds · Matte black</p></div>
          <div class="feature-price"><span class="old-price">$319.99</span><strong>$284.36</strong></div>
        </div>
      </div>
    </section>

    <section class="service-strip">
      <div class="shell service-grid">
        <div><span class="service-icon">UT</span><p><b>Local pickup</b><small>Fast, familiar, in-store</small></p></div>
        <div><span class="service-icon">✓</span><p><b>FFL transfers</b><small>Clear steps, no surprises</small></p></div>
        <div><span class="service-icon">50</span><p><b>Since 1973</b><small>Independent and family owned</small></p></div>
        <div><span class="service-icon">?</span><p><b>Real support</b><small>Call or visit before you buy</small></p></div>
      </div>
    </section>

    <section class="section shell">
      <div class="section-heading">
        <div><p class="eyebrow">Start with what you need</p><h2>SHOP BY DEPARTMENT</h2></div>
        <a class="text-link" href="/dg/shop">View all departments <span>→</span></a>
      </div>
      <div class="category-grid">
        {dgCategories.map((category, index) => (
          <a class={`category-card ${category.className}`} href="/dg/shop">
            <span class="category-number">0{index + 1}</span>
            <div><h3>{category.name}</h3><p>{category.meta}</p></div>
            <img src={category.image} alt="" />
            <span class="round-arrow">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section products-section">
      <div class="shell">
        <div class="section-heading">
          <div><p class="eyebrow">Available now</p><h2>STORE PICKS</h2></div>
          <div class="tab-row" aria-label="Product categories"><span class="active">Featured</span><span>Handguns</span><span>Rifles</span><span>Shotguns</span></div>
        </div>
        <div class="product-grid">{dgProducts.map((product) => <DGProductCard product={product} />)}</div>
      </div>
    </section>

    <section class="visit shell">
      <div><p class="eyebrow">Come see us</p><h2>A REAL STORE.<br />REAL PEOPLE.</h2><p>4926 South Redwood Road, Taylorsville, UT 84123</p></div>
      <div class="hours-card"><div><span>Mon–Fri</span><strong>10 AM – 9 PM</strong></div><div><span>Saturday</span><strong>10 AM – 6 PM</strong></div><div><span>Sunday</span><strong>Closed</strong></div><a href="tel:+18019661802">801-966-1802</a></div>
    </section>
  </main>
  <DGFooter />
</DGLayout>
