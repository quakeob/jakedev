                    <span class="fuel-input__spinner"></span>
                    <span>parsing with claude...</span>
                  </div>
                  <div class="fuel-input__foods" id="fuel-foods" style="display:none;">
                    <div class="fuel-food-item">
                      <span class="fuel-food-item__emoji">🥚</span>
                      <div class="fuel-food-item__info">
                        <div class="fuel-food-item__name">Eggs (2 large)</div>
                        <div class="fuel-food-item__macros">144 cal · 12g P · 1g C · 10g F</div>
                      </div>
                      <span class="fuel-food-item__conf">98%</span>
                    </div>
                    <div class="fuel-food-item">
                      <span class="fuel-food-item__emoji">🍞</span>
                      <div class="fuel-food-item__info">
                        <div class="fuel-food-item__name">Sourdough Toast</div>
                        <div class="fuel-food-item__macros">128 cal · 4g P · 25g C · 1g F</div>
                      </div>
                      <span class="fuel-food-item__conf">95%</span>
                    </div>
                    <div class="fuel-food-item">
                      <span class="fuel-food-item__emoji">🧈</span>
                      <div class="fuel-food-item__info">
                        <div class="fuel-food-item__name">Butter (1 tbsp)</div>
                        <div class="fuel-food-item__macros">102 cal · 0g P · 0g C · 12g F</div>
                      </div>
                      <span class="fuel-food-item__conf">92%</span>
                    </div>
                    <div class="fuel-food-item">
                      <span class="fuel-food-item__emoji">☕</span>
                      <div class="fuel-food-item__info">
                        <div class="fuel-food-item__name">Black Coffee</div>
                        <div class="fuel-food-item__macros">2 cal · 0g P · 0g C · 0g F</div>
                      </div>
                      <span class="fuel-food-item__conf">99%</span>
                    </div>
                    <div class="fuel-food-item__total">
                      <span>Total</span>
                      <span>376 cal</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- SCREEN 2: Meals breakdown -->
            <div class="fuel-screen" data-screen="2">
              <div class="fuel-meals">
                <div class="fuel-meals__header">Today's Meals</div>
                <div class="fuel-meal-group">
                  <div class="fuel-meal-group__label">🌅 Breakfast · 376 cal</div>
                  <div class="fuel-meal-entry">
                    <span>🥚 Eggs (2 large)</span><span>144</span>
                  </div>
                  <div class="fuel-meal-entry">
                    <span>🍞 Sourdough Toast</span><span>128</span>
                  </div>
                  <div class="fuel-meal-entry">
                    <span>🧈 Butter</span><span>102</span>
                  </div>
                  <div class="fuel-meal-entry">
                    <span>☕ Black Coffee</span><span>2</span>
                  </div>
                </div>
                <div class="fuel-meal-group">
                  <div class="fuel-meal-group__label">☀️ Lunch · 520 cal</div>
                  <div class="fuel-meal-entry">
                    <span>🥗 Chicken Salad</span><span>380</span>
                  </div>
                  <div class="fuel-meal-entry">
                    <span>🍎 Apple</span><span>95</span>
                  </div>
                  <div class="fuel-meal-entry">
                    <span>🥜 Almonds (handful)</span><span>45</span>
                  </div>
                </div>
                <div class="fuel-meal-group">
                  <div class="fuel-meal-group__label">🌙 Dinner · 320 cal</div>
                  <div class="fuel-meal-entry">
                    <span>🍣 Salmon (4oz)</span><span>234</span>
                  </div>
                  <div class="fuel-meal-entry">
                    <span>🥦 Steamed Broccoli</span><span>86</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- SCREEN 3: Watch + HealthKit -->
            <div class="fuel-screen" data-screen="3">
              <div class="fuel-health">
                <div class="fuel-health__header">Integrations</div>
                <div class="fuel-health__card">
                  <div class="fuel-health__card-icon">⌚</div>
                  <div class="fuel-health__card-info">
                    <div class="fuel-health__card-title">Apple Watch</div>
                    <div class="fuel-health__card-desc">Quick log from your wrist. View calories, macros, and water. Add foods with voice or templates.</div>
                  </div>
                </div>
                <div class="fuel-health__card">
                  <div class="fuel-health__card-icon">❤️</div>
