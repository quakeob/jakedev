        setInterval(function() {
          if (currentScreen !== 1) return;
          var pick = toggleEls[Math.floor(Math.random() * toggleEls.length)];
          pick.classList.toggle('wp-settings__toggle--on');
          setTimeout(function() { pick.classList.toggle('wp-settings__toggle--on'); }, 800);
        }, 3000);
      })();
    </script>
  )}

